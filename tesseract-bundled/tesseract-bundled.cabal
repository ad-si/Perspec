cabal-version: 3.0
name: tesseract-bundled
version: 5.5.3
synopsis: Tesseract OCR library compiled from source
description:
  Builds the C and C++ sources of Tesseract (5.5.3)
  and its image processing library Leptonica (1.87.0),
  so that Tesseract's C API can be used without a system installation.
  .
  Only the LSTM engine is included,
  and Leptonica is built without any image format libraries,
  so images must be passed to Tesseract as raw pixels.
  .
  Run @vendor.sh@ to update the vendored sources.

license: Apache-2.0
license-files:
  tesseract/LICENSE
  leptonica/leptonica-license.txt

build-type: Simple
extra-doc-files:
  readme.md

extra-source-files:
  config/leptonica-include/*.h
  config/leptonica/*.h
  config/tesseract-include/tesseract/*.h
  config/tesseract/*.h
  leptonica/src/*.h
  tesseract/include/tesseract/*.h
  tesseract/src/**/*.h
  vendor.sh

common tesseract-options
  default-language: Haskell2010
  build-depends: system-cxx-std-lib ==1.0
  cxx-options:
    -std=c++20
    -O2
    -w
    -DHAVE_CONFIG_H
    -- Keep the images of text lines as Leptonica pixes
    -- instead of encoding them as PNG, which is only needed for training.
    -- Must be the same for all files, as it changes the layout of `ImageData`.
    -DTESSERACT_IMAGEDATA_AS_PIX

  include-dirs:
    config/tesseract
    config/tesseract-include
    tesseract/include
    tesseract/src/api
    tesseract/src/arch
    tesseract/src/ccmain
    tesseract/src/ccstruct
    tesseract/src/ccutil
    tesseract/src/classify
    tesseract/src/cutil
    tesseract/src/dict
    tesseract/src/lstm
    tesseract/src/textord
    tesseract/src/viewer
    tesseract/src/wordrec
    leptonica/src
    config/leptonica-include

-- Leptonica as a separate library, as it needs a different `config_auto.h`
library leptonica
  visibility: private
  default-language: Haskell2010
  cc-options:
    -O2
    -w
    -DHAVE_CONFIG_H
    -- Don't print messages to stderr.
    -- Tesseract always creates a bitmap font for debug images,
    -- which fails without libtiff and would print errors on every run.
    -DNO_CONSOLE_IO
    -- GHC's runtime system defines functions with the same names
    -DstartTimer=leptStartTimer
    -DstopTimer=leptStopTimer

  include-dirs:
    config/leptonica
    config/leptonica-include
    leptonica/src

