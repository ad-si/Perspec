-- Cabal can't set compiler flags per source file,
-- so each file that needs CPU specific instructions gets its own library.
-- Tesseract detects at runtime which of them the CPU supports.
-- The files are empty when compiled for other architectures.

-- AVX
library tesseract-avx
  import: tesseract-options
  visibility: private
  cxx-sources:
    tesseract/src/arch/dotproductavx.cpp

  if arch(x86_64)
    cxx-options: -mavx

-- AVX2
library tesseract-avx2
  import: tesseract-options
  visibility: private
  cxx-sources:
    tesseract/src/arch/intsimdmatrixavx2.cpp

  if arch(x86_64)
    cxx-options: -mavx2

-- AVX-512
library tesseract-avx512f
  import: tesseract-options
  visibility: private
  cxx-sources:
    tesseract/src/arch/dotproductavx512.cpp

  if arch(x86_64)
    cxx-options: -mavx512f

-- FMA
library tesseract-fma
  import: tesseract-options
  visibility: private
  cxx-sources:
    tesseract/src/arch/dotproductfma.cpp

  if arch(x86_64)
    cxx-options: -mfma

-- SSE 4.1
library tesseract-sse41
  import: tesseract-options
  visibility: private
  cxx-sources:
    tesseract/src/arch/dotproductsse.cpp
    tesseract/src/arch/intsimdmatrixsse.cpp

  if arch(x86_64)
    cxx-options: -msse4.1

